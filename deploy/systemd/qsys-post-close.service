[Unit]
Description=Qsys Post-Close — batch dispatch all candidate strategies
Documentation=docs/runbooks/daily-ops.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/liuming/.openclaw/workspace/SysQ
Environment=PYTHONPATH=/home/liuming/.openclaw/workspace/SysQ
Environment=HTTPS_PROXY=http://172.31.144.1:12334
Environment=HTTP_PROXY=http://172.31.144.1:12334
EnvironmentFile=/home/liuming/.openclaw/.env
ExecStart=/home/liuming/.openclaw/.mamba/envs/dl/bin/python scripts/run_daily_batch.py \
    --stage candidate \
    --mode postclose \
    --trade-date auto \
    --output-root runs
StandardOutput=append:/home/liuming/.openclaw/logs/postclose.log
StandardError=append:/home/liuming/.openclaw/logs/postclose.log

[Install]
WantedBy=default.target
