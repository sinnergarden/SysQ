[Unit]
Description=Qsys Candidate Weekly Train — retrain all candidate strategy models
After=network-online.target
Wants=network-online.target
Documentation=docs/runbooks/daily-ops.md

[Service]
Type=oneshot
WorkingDirectory=/path/to/SysQ
# EnvironmentFile=-/path/to/SysQ/.env
ExecStart=/usr/bin/env bash -lc 'cd /path/to/SysQ && python scripts/run_daily_batch.py --stage candidate --mode train --output-root runs --no-notify'
StandardOutput=append:/var/log/qsys/candidate-train.log
StandardError=append:/var/log/qsys/candidate-train.log

[Install]
WantedBy=default.target
