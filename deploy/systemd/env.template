# Telegram bot credentials for systemd services
# 1. Create a Telegram bot via @BotFather to get a bot token
# 2. Start a chat with your bot and send a message
# 3. Run: curl https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates to get your chat_id
# 4. Fill in both values below
QSYS_TELEGRAM_BOT_TOKEN=
QSYS_TELEGRAM_ALLOWED_CHAT_ID=
