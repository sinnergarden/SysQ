[Unit]
Description=Qsys Pre-Open Pipeline (signal → plan → shadow sim)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/liuming/.openclaw/workspace/SysQ
Environment=PYTHONPATH=/home/liuming/.openclaw/workspace/SysQ
Environment=HTTPS_PROXY=http://172.31.144.1:12334
Environment=HTTP_PROXY=http://172.31.144.1:12334
EnvironmentFile=/home/liuming/.openclaw/.env
ExecStart=/home/liuming/.openclaw/workspace/SysQ/scripts/run_preopen.sh
StandardOutput=append:/home/liuming/.openclaw/logs/preopen.log
StandardError=append:/home/liuming/.openclaw/logs/preopen.log

[Install]
WantedBy=default.target
