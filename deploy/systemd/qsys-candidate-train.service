[Unit]
Description=Qsys Candidate Weekly Model Training
Documentation=https://github.com/sinnergarden/SysQ
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/liuming/.openclaw/workspace/SysQ
Environment=PYTHONPATH=/home/liuming/.openclaw/workspace/SysQ
Environment=PYTHONUNBUFFERED=1
Environment=HTTP_PROXY=http://172.31.144.1:12334
Environment=HTTPS_PROXY=http://172.31.144.1:12334
EnvironmentFile=/home/liuming/.openclaw/.env
ExecStart=/home/liuming/.openclaw/workspace/.mamba/envs/dl/bin/python \
    scripts/run_daily_batch.py \
    --stage candidate \
    --mode train \
    --output-root runs
StandardOutput=append:/home/liuming/.openclaw/logs/candidate-train.log
StandardError=append:/home/liuming/.openclaw/logs/candidate-train.log

[Install]
WantedBy=default.target
