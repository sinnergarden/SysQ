[Unit]
Description=Qsys Candidate Weekly Train — retrain all candidate strategy models
Documentation=docs/runbooks/daily-ops.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# User=your_user
WorkingDirectory=/path/to/SysQ
# EnvironmentFile=-/path/to/SysQ/.env
# Environment=HTTPS_PROXY=http://proxy:port
# Environment=HTTP_PROXY=http://proxy:port
ExecStart=/path/to/python scripts/run_daily_batch.py \
    --stage candidate \
    --mode train \
    --output-root runs
StandardOutput=append:/var/log/qsys/candidate-train.log
StandardError=append:/var/log/qsys/candidate-train.log

[Install]
WantedBy=default.target
