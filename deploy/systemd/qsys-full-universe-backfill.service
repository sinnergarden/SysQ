[Unit]
Description=Qsys Full-Universe Raw Backfill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=QSYS_ROOT
Environment=PYTHONPATH=QSYS_ROOT
ExecStart=QSYS_PYTHON QSYS_ROOT/scripts/ops/run_full_universe_backfill.py --base-dir QSYS_ROOT --apply --batch-size 50 --max-batches 4 --triggered-by systemd
