[Unit]
Description=Qsys Alpha V1 Weekly Model Training
Documentation=https://github.com/sinnergarden/SysQ
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/liuming/.openclaw/workspace/SysQ
Environment=PYTHONPATH=/home/liuming/.openclaw/workspace/SysQ
Environment=HTTPS_PROXY=http://172.31.144.1:12334
Environment=HTTP_PROXY=http://172.31.144.1:12334
EnvironmentFile=/home/liuming/.openclaw/.env
ExecStart=/home/liuming/.openclaw/workspace/.mamba/envs/dl/bin/python /home/liuming/.openclaw/workspace/SysQ/scripts/run_alpha_v1_weekly_train.py
StandardOutput=append:/home/liuming/.openclaw/logs/alpha_v1_weekly_train.log
StandardError=append:/home/liuming/.openclaw/logs/alpha_v1_weekly_train.log

[Install]
WantedBy=default.target
